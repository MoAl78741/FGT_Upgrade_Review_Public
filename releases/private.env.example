# Copy to .env; default port is localhost only.
HOST_PORT=8001
ENABLE_SCRAPING=false
# Optional trusted Selenium Grid, used only when scraping is enabled.
SELENIUM_GRID_URL=

# Optional processing limits (MiB = 1024 * 1024 bytes).
MAX_PDF_FILES=4
MAX_PDF_MIB=50
MAX_UPLOAD_MIB=150
MAX_PDF_PAGES=500
JOB_TIMEOUT_SECONDS=1800
MAX_WORKERS=2
MAX_QUEUED_JOBS=10
MAX_STORAGE_MIB=2048
WORKER_MEMORY_MIB=2048

# First sign-in: admin / password. A new password is required before access.
TEAM_AUTH_ENABLED=true
