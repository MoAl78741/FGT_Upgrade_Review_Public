# Copy to .env and replace both URLs before starting.
HOST_PORT=8001
PUBLIC_ORIGIN=https://review.example.com
SOURCE_CODE_URL=https://your-source-host.example/exact-deployed-source.tar.gz

# Optional processing limits (MiB = 1024 * 1024 bytes).
MAX_PDF_FILES=100
MAX_PDF_MIB=50
MAX_UPLOAD_MIB=150
MAX_PDF_PAGES=500
JOB_TIMEOUT_SECONDS=1800
MAX_WORKERS=2
MAX_QUEUED_JOBS=10
MAX_STORAGE_MIB=2048
WORKER_MEMORY_MIB=2048

# Optional HTTPS signup/contact destination for the Public Upgrade to Pro page.
PRO_UPGRADE_URL=
