# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.env
.env.*
venv/
.venv/
env/
*.egg-info/
dist/
build/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
*.log
npm-debug.log*

# ── Runtime data (mount as Docker volumes, never commit) ──────────────────────
fgt_upgrade.db
uploads/
output/
data/

# ── Large binaries ────────────────────────────────────────────────────────────
*.pdf

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

*.worker.lock
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Local deployment state
stack.env
*.db
*.db-*
work/

# Operator-generated proxy configuration
deployment/caddy.json

# Automated QA artifacts and browser traces (synthetic test data only)
test-results/
frontend/test-results/
frontend/playwright-report/

# Version-controlled release catalog (not runtime storage)
!frontend/src/data/
!frontend/src/data/*.json
